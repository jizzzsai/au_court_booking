# Copy this file to .env beside compose.vm.yml on the Linux VM.
# Use your existing site's origin; the application lives only at /au-campus-court.
PUBLIC_ORIGIN=http://YOUR_FQDN_OR_IP
PUBLIC_SITE_URL=http://YOUR_FQDN_OR_IP/au-campus-court
# Choose a loopback port that is not already in use on the VM.
WEB_HOST_PORT=3100
IMAGE_TAG=v1

# Generate each secret separately with: openssl rand -hex 32
# Use only hexadecimal characters for DB_PASSWORD because it also appears in a database URL.
MYSQL_ROOT_PASSWORD=REPLACE_WITH_RANDOM_HEX
DB_PASSWORD=REPLACE_WITH_RANDOM_HEX
JWT_SECRET=REPLACE_WITH_RANDOM_HEX
PEER_API_KEY=REPLACE_WITH_RANDOM_HEX
